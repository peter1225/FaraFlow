FARAFLOW_ENVIRONMENT=development
FARAFLOW_LOG_LEVEL=INFO
FARAFLOW_API_HOST=0.0.0.0
FARAFLOW_API_PORT=8080
FARAFLOW_DATABASE_URL=sqlite+aiosqlite:///./data/faraflow.db
FARAFLOW_ARTIFACT_ROOT=./artifacts
FARAFLOW_BROWSER_STATE_ROOT=./browser-state
FARAFLOW_CODE_WORK_ROOT=./data/code-workspaces

# Local code workspaces are disabled by default. Enable only when the API is
# bound to 127.0.0.1 and set one or more parent directories that may be opened.
FARAFLOW_ENABLE_LOCAL_WORKSPACES=false
FARAFLOW_WORKSPACE_ALLOWED_ROOTS=[]
FARAFLOW_BROWSER_HEADLESS=true
FARAFLOW_BROWSER_CHANNEL=chromium
FARAFLOW_BROWSER_VIEWPORT_WIDTH=1440
FARAFLOW_BROWSER_VIEWPORT_HEIGHT=900
FARAFLOW_BROWSER_TIMEOUT_MS=30000

# A6000 上的本地 vLLM OpenAI-compatible endpoint
FARAFLOW_FARA_BASE_URL=http://127.0.0.1:5000/v1
FARAFLOW_FARA_API_KEY=not-needed
FARAFLOW_FARA_MODEL=microsoft/Fara1.5-9B

# Dedicated chat endpoint. Browser automation remains on the Fara endpoint above.
FARAFLOW_CHAT_BASE_URL=http://10.65.1.120:11434/v1
FARAFLOW_CHAT_API_KEY=not-needed
FARAFLOW_CHAT_MODEL=gemma4:26b
FARAFLOW_CHAT_TIMEOUT_SECONDS=120
FARAFLOW_CHAT_MAX_TOKENS=2048
FARAFLOW_CHAT_DISABLE_THINKING=false

# Separate coding model. Code tasks use the same Gemma endpoint as ordinary chat.
FARAFLOW_CODE_BASE_URL=http://10.65.1.120:11434/v1
FARAFLOW_CODE_API_KEY=not-needed
FARAFLOW_CODE_MODEL=gemma4:26b
FARAFLOW_CODE_TIMEOUT_SECONDS=120
FARAFLOW_CODE_MAX_TOKENS=4096
FARAFLOW_CODE_MAX_STEPS=50
FARAFLOW_CODE_MAX_RUNTIME_MINUTES=20
FARAFLOW_CODE_MAX_CONCURRENT_RUNS=1

# Local desktop control is disabled by default. Enable only for a loopback API.
FARAFLOW_ENABLE_DESKTOP_CONTROL=false
FARAFLOW_DESKTOP_BASE_URL=
FARAFLOW_DESKTOP_API_KEY=not-needed
FARAFLOW_DESKTOP_MODEL=
FARAFLOW_DESKTOP_TIMEOUT_SECONDS=120
FARAFLOW_DESKTOP_MAX_TOKENS=2048
FARAFLOW_DESKTOP_MAX_SCREENSHOTS=3
FARAFLOW_DESKTOP_MAX_STEPS=50
FARAFLOW_DESKTOP_MAX_RUNTIME_MINUTES=15
FARAFLOW_DESKTOP_MAX_CONCURRENT_RUNS=1
FARAFLOW_DESKTOP_CAPTURE_MODE=window
FARAFLOW_DESKTOP_ALLOWED_APPS=[]
FARAFLOW_DESKTOP_REQUIRE_CONFIRMATION=true
FARAFLOW_DESKTOP_UNATTENDED_MODE=false

FARAFLOW_FARA_TIMEOUT_SECONDS=120
FARAFLOW_FARA_MAX_TOKENS=2048
FARAFLOW_FARA_MAX_SCREENSHOTS=3
FARAFLOW_FARA_COORDINATE_SPACE=1000

# 安全默认值
FARAFLOW_DEFAULT_ALLOWED_DOMAINS=["bing.com"]
FARAFLOW_ALLOW_PRIVATE_NETWORKS=false
FARAFLOW_MAX_CONCURRENT_SESSIONS=2
FARAFLOW_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Docker Compose / A6000 部署参数（上线前务必替换口令）
POSTGRES_PASSWORD=change-me-in-production
MINIO_ROOT_USER=faraflow
MINIO_ROOT_PASSWORD=change-me-in-production
HF_TOKEN=
VLLM_MAX_MODEL_LEN=65536
VLLM_GPU_MEMORY_UTILIZATION=0.92
